# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: model names (defaults shown)
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001

# Where the Streamlit frontend finds the FastAPI backend.
#   Set it     -> two-terminal mode (run uvicorn separately)
#   Remove it  -> one-terminal mode: Streamlit starts FastAPI itself (same as the cloud)
BACKEND_URL=http://localhost:8000
